[Unit]
Description=Hermes private web dashboard
Wants=network-online.target
After=network-online.target hermes-gateway-orchestrator.service
Requires=hermes-gateway-orchestrator.service

[Service]
Type=simple
Environment=DOCKER_HOST=unix:///run/user/%U/docker.sock
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HERMES_DASHBOARD_HOST=127.0.0.1
EnvironmentFile=-%h/.config/hermes/dashboard.env
ExecStart=@HERMES_BIN@ -p orchestrator dashboard --host ${HERMES_DASHBOARD_HOST} --port 9119 --no-open
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.hermes /srv/hermes

[Install]
WantedBy=default.target
