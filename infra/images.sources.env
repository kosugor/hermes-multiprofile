# Floating sources are inputs only. scripts/lock-images.sh resolves them to
# linux/arm64 repo digests in images.lock.env. Review and commit that generated
# lock file as part of each tested deployment release.
SEARXNG_IMAGE_SOURCE=docker.io/searxng/searxng:latest
VALKEY_IMAGE_SOURCE=docker.io/valkey/valkey:8-alpine
FIRECRAWL_REQUIRED_RELEASE=v2.11.0
# v2.11.0 is Git commit ef12eb36b2f3. GHCR did not publish a v2.11.0
# tag; it published the architecture-specific commit tag below.
FIRECRAWL_REQUIRED_COMMIT=ef12eb36b2f3
FIRECRAWL_IMAGE_SOURCE=ghcr.io/firecrawl/firecrawl:sha-ef12eb36b2f3-linux-arm64
PLAYWRIGHT_IMAGE_SOURCE=ghcr.io/firecrawl/playwright-service:linux-arm64
NUQ_POSTGRES_IMAGE_SOURCE=ghcr.io/firecrawl/nuq-postgres:linux-arm64
REDIS_IMAGE_SOURCE=docker.io/library/redis:7-alpine
RABBITMQ_IMAGE_SOURCE=docker.io/library/rabbitmq:3-management-alpine
SANDBOX_BASE_IMAGE_SOURCE=docker.io/nikolaik/python-nodejs:python3.11-nodejs22-bookworm
